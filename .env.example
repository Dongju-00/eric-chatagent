# 네이버 뉴스 데이터 수집을 위해
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Gemini LLM 및 검색 품질 평가를 위해
GOOGLE_API_KEY=

# vLLM 라우터 (질문 분류). fallback 자유 답변은 OpenRouter로 옮겼다.
VLLM_BASE_URL=
VLLM_API_KEY=

# fallback 자유 답변용 OpenRouter. 키가 없으면 고정 안내 문구로 답한다.
# 모델을 비우면 무료 티어 기본값을 쓴다 (src/model/llm/openrouter.py 참고).
ERIC_CHATAGENT_OPENROUTER_KEY=
ERIC_CHATAGENT_OPENROUTER_MODEL=

# 선택 사항: LangChain/LangSmith SDK에서 읽는 추적 설정
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# 선택 사항: 경로 재지정 (미설정 시 저장소 구조에서 자동 유도)
# 자세한 기본값은 src/model/paths.py 참고
# ERIC_PROJECT_ROOT=
# ERIC_MODEL_ROOT=
# ERIC_DATA_DIR=
# ERIC_CHECKPOINT_DIR=
# ERIC_CHROMA_PATH=
# ERIC_SP_PREFIX=
